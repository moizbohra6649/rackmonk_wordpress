
# BEGIN Rackmonk speed
# Compress text files (SVG images compress to about a quarter of their size).
<IfModule mod_filter.c>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml font/ttf font/otf
</IfModule>
</IfModule>
<IfModule mod_headers.c>
# Images can be replaced from WordPress at the same address, so browsers re-check them after an hour.
<FilesMatch "\.(svg|png|jpe?g|gif|webp|avif|ico)$">
Header set Cache-Control "public, max-age=3600"
</FilesMatch>
# Theme and plugin files carry a version number (?ver=...), so they can be kept for a week.
<FilesMatch "\.(css|js|woff2?|ttf|otf|eot)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>
# END Rackmonk speed

# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /rackmonk_wordpress/website/
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /rackmonk_wordpress/website/index.php [L]
</IfModule>

# END WordPress